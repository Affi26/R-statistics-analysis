"Fat Free Mass" = "Fettfri massa (kg)",
"Muscle Mass" = "Muskelmassa (kg)",
"Fat Mass" = "Fettmassa (kg)",
"Fat Percentage" = "Fettprocent (%)",
"Total Body Water" = "Totalt kroppsvatten (kg)"
)
